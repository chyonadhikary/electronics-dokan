{
  "name": "Chyon AI 4-Wheel Robot ESP32-S3 N16R8",
  "version": "2.5.0",
  "new_install_prompt_erase": true,
  "builds": [
    {
      "chipFamily": "ESP32-S3",
      "parts": [
        {
          "path": "bootloader.bin",
          "offset": 0
        },
        {
          "path": "partition-table.bin",
          "offset": 32768
        },
        {
          "path": "ota_data_initial.bin",
          "offset": 53248
        },
        {
          "path": "xiaozhi.bin",
          "offset": 131072
        },
        {
          "path": "generated_assets.bin",
          "offset": 8388608
        }
      ]
    }
  ],
  "flashMode": "dio",
  "flashFreq": "80m",
  "flashSize": "16MB",
  "monitorBaud": 115200,
  "description": "Exact ESP-IDF flash map from build/flasher_args.json. This project must be written as five parts at their original offsets; do not flash xiaozhi.bin alone."
}
