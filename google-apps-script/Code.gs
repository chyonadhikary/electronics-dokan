const CFG={sheet:'Orders',base:['Order ID','Date & Time','Customer Name','Phone','WhatsApp','Email','Address','District','Area','Products','Quantity','Subtotal','Delivery Charge','Total','Payment Method','Customer Note','Order Status'],extra:['Payment Mobile','Transaction ID','Payment Status','Shipping Label Status','Carrier','Tracking Number','Delivery Method','Discount','Last Updated'],statuses:['Pending','Confirmed','Processing','Packed','Shipped','In Transit','Delivered','Cancelled','On Hold'],payments:['Pending','Paid / Confirmed','Failed','Rejected','Cancelled','Refunded','COD / Cash on Delivery'],carriers:['Bangladesh Post Office','Bangladesh Post','Steadfast Courier','Other']};
function props_(){return PropertiesService.getScriptProperties()}
function clean_(v){return String(v==null?'':v).replace(/[<>]/g,'').replace(/[\r\n]+/g,' ').trim().slice(0,2000)}
function json_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
function sheet_(){var id=props_().getProperty('SHEET_ID');if(!id)throw Error('Missing server configuration: SHEET_ID');var ss=SpreadsheetApp.openById(id),s=ss.getSheetByName(CFG.sheet)||ss.insertSheet(CFG.sheet);if(!s.getLastRow())s.appendRow(CFG.base.concat(CFG.extra));var h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);CFG.base.concat(CFG.extra).forEach(function(n){if(h.indexOf(n)<0){s.getRange(1,s.getLastColumn()+1).setValue(n);h.push(n)}});return s}
function cols_(s){return s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String)}
function col_(s,n){var i=cols_(s).indexOf(n);if(i<0)throw Error('Missing column '+n);return i+1}
function val_(row,s,n){return row[col_(s,n)-1]||''}
function find_(s,id){var last=s.getLastRow();if(last<2)return null;var rows=s.getRange(2,1,last-1,s.getLastColumn()).getValues(),ic=col_(s,'Order ID'),tc=col_(s,'Tracking Number');for(var i=0;i<rows.length;i++)if(String(rows[i][ic-1]).trim()===id||String(rows[i][tc-1]).trim()===id)return{row:i+2,v:rows[i]};return null}
function doGet(e){var p=e&&e.parameter||{};if(p.action==='track')return track_(clean_(p.orderId||p.trackingNumber));return HtmlService.createHtmlOutput(dash_()).setTitle('Electronics Dokan Order Desk')}
function doPost(e){try{var p=JSON.parse(e.postData.contents||'{}'),s=sheet_();if(!p.clientRequestId)throw Error('Missing clientRequestId');var existing=find_(s,p.clientRequestId);if(existing)return json_({ok:true,duplicate:true,orderId:val_(existing.v,s,'Order ID')});var now=new Date(),id=next_(s),c=p.customer||{},r=Array(s.getLastColumn()).fill(''),put=function(n,v){r[col_(s,n)-1]=v};put('Order ID',id);put('Date & Time',now);put('Customer Name',clean_(c.name));put('Phone',clean_(c.phone));put('WhatsApp',clean_(c.whatsapp||c.phone));put('Email',clean_(c.email));put('Address',[c.address,c.postOffice,c.postCode,c.division].filter(Boolean).map(clean_).join(', '));put('District',clean_(c.district));put('Area',clean_(c.area));put('Products',(p.items||[]).map(function(x){return clean_(x.productName)+' ['+clean_(x.sku||x.productId)+']'}).join(' | '));put('Quantity',(p.items||[]).map(function(x){return x.quantity}).join(' + '));put('Subtotal',Number(p.subtotal)||0);put('Delivery Charge',Number(p.deliveryCharge)||0);put('Total',Number(p.total)||0);put('Payment Method',clean_(p.paymentMethod));put('Customer Note',clean_(p.customerNote));put('Order Status','Pending');put('Payment Mobile',clean_(p.paymentMobile));put('Transaction ID',clean_(p.transactionId));put('Payment Status',p.paymentMethod==='Cash on Delivery'?'COD / Cash on Delivery':'Pending');put('Shipping Label Status','Not Printed');put('Carrier',clean_(p.courier));put('Tracking Number','');put('Delivery Method',clean_(p.courier));put('Discount',Number(p.discount)||0);put('Last Updated',now);s.appendRow(r);format_(s);var sent=false;try{telegram_(id,p)}catch(x){}return json_({ok:true,orderId:id,notificationSent:sent})}catch(x){return json_({ok:false,error:String(x.message||x)})}}
function next_(s){var d=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Dhaka','yyyyMMdd'),last=s.getLastRow(),ic=col_(s,'Order ID'),max=0;if(last>1)s.getRange(2,ic,last-1,1).getValues().forEach(function(x){var m=String(x[0]).match(new RegExp('^ED-'+d+'-(\\d+)$'));if(m)max=Math.max(max,Number(m[1]))});return 'ED-'+d+'-'+String(max+1).padStart(4,'0')}
function telegram_(id,p){var t=props_().getProperty('TELEGRAM_BOT_TOKEN'),c=props_().getProperty('TELEGRAM_CHAT_ID');if(!t||!c)throw Error('Telegram is not configured');var x='<b>NEW ORDER</b>\nOrder ID: '+clean_(id)+'\nCustomer: '+clean_((p.customer||{}).name)+'\nPhone: '+clean_((p.customer||{}).phone)+'\nTotal: '+(Number(p.total)||0)+'\nPayment: '+clean_(p.paymentMethod)+'\nPayment mobile: '+clean_(p.paymentMobile)+'\nTransaction ID: '+clean_(p.transactionId);var r=UrlFetchApp.fetch('https://api.telegram.org/bot'+encodeURIComponent(t)+'/sendMessage',{method:'post',contentType:'application/json',payload:JSON.stringify({chat_id:c,text:x}),muteHttpExceptions:true});if(!JSON.parse(r.getContentText()||'{}').ok)throw Error('Telegram rejected message')}
function track_(id){var s=sheet_(),f=find_(s,id);if(!f)return json_({ok:false,error:'Order not found'});return json_({ok:true,order:{orderId:val_(f.v,s,'Order ID'),dateTime:String(val_(f.v,s,'Date & Time')),status:val_(f.v,s,'Order Status')||'Pending',total:Number(val_(f.v,s,'Total'))||0,paymentMethod:val_(f.v,s,'Payment Method'),paymentStatus:val_(f.v,s,'Payment Status')||'Pending',deliveryMethod:val_(f.v,s,'Delivery Method'),carrier:val_(f.v,s,'Carrier'),trackingNumber:val_(f.v,s,'Tracking Number'),customerName:val_(f.v,s,'Customer Name'),itemSummary:val_(f.v,s,'Products'),quantity:val_(f.v,s,'Quantity')}})}
function setupOrdersSheet(){format_(sheet_())}
function format_(s){s.setFrozenRows(1);s.getRange(1,1,1,s.getLastColumn()).setFontWeight('bold').setBackground('#102a43').setFontColor('#fff').setWrap(true);['Order Status','Payment Status','Shipping Label Status','Carrier'].forEach(function(n){var c=col_(s,n),a=n==='Order Status'?CFG.statuses:n==='Payment Status'?CFG.payments:n==='Shipping Label Status'?['Not Printed','Printed']:[''].concat(CFG.carriers);if(a.length>1)s.getRange(2,c,Math.max(1,s.getMaxRows()-1),1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(a,true).setAllowInvalid(false).build())})}
function updateOrderStatus(id,v){return update_(id,'Order Status',v,CFG.statuses)}
function updatePaymentStatus(id,v){return update_(id,'Payment Status',v,CFG.payments)}
function updateCarrier(id,v){return update_(id,'Carrier',v,CFG.carriers)}
function updateTracking(id,v){return update_(id,'Tracking Number',v,null)}
function markLabelPrinted(id){return update_(id,'Shipping Label Status','Printed',['Not Printed','Printed'])}
function update_(id,n,v,allowed){var s=sheet_(),f=find_(s,clean_(id)),x=clean_(v);if(!f)throw Error('Order not found');if(allowed&&allowed.indexOf(x)<0)throw Error('Invalid value');s.getRange(f.row,col_(s,n)).setValue(x);s.getRange(f.row,col_(s,'Last Updated')).setValue(new Date());return row_(s.getRange(f.row,1,1,s.getLastColumn()).getValues()[0],s)}
function row_(r,s){return{orderId:val_(r,s,'Order ID'),dateTime:String(val_(r,s,'Date & Time')),customerName:val_(r,s,'Customer Name'),phone:val_(r,s,'Phone'),address:val_(r,s,'Address'),district:val_(r,s,'District'),area:val_(r,s,'Area'),products:val_(r,s,'Products'),quantity:val_(r,s,'Quantity'),total:Number(val_(r,s,'Total'))||0,paymentMethod:val_(r,s,'Payment Method'),paymentMobile:val_(r,s,'Payment Mobile'),transactionId:val_(r,s,'Transaction ID'),paymentStatus:val_(r,s,'Payment Status'),status:val_(r,s,'Order Status'),carrier:val_(r,s,'Carrier'),trackingNumber:val_(r,s,'Tracking Number'),deliveryMethod:val_(r,s,'Delivery Method')}}
function dashboardOrders(){var s=sheet_(),last=s.getLastRow();if(last<2)return[];return s.getRange(2,1,last-1,s.getLastColumn()).getValues().reverse().map(function(r){return row_(r,s)})}
function dash_(){return `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font:14px Arial;background:#f1f5f9;color:#102a43;margin:0}.head{background:linear-gradient(135deg,#082f49,#0f766e);color:white;padding:22px}.wrap{padding:14px}.card{background:white;border:1px solid #dbe5ee;border-radius:12px;padding:14px;margin:10px 0;box-shadow:0 4px 12px #102a4310}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.muted{color:#64748b;font-size:12px}.tag{display:inline-block;border-radius:99px;padding:4px 8px;background:#e0f2fe;color:#075985;font-size:12px}.btn{background:#0f766e;color:white;border:0;border-radius:7px;padding:8px 10px;cursor:pointer}.btn.alt{background:#e2e8f0;color:#102a43}select,input{width:100%;box-sizing:border-box;padding:8px;border:1px solid #cbd5e1;border-radius:7px;margin:3px 0 7px}.actions{display:flex;gap:6px;margin-top:8px}.empty{text-align:center;padding:30px;color:#64748b}</style><div class="head"><h2>Electronics Dokan Order Desk</h2><div>Payment, delivery, tracking and 58mm print</div></div><div class="wrap"><input id="q" placeholder="Search order, name, phone or tracking" oninput="render()"><div id="list"></div></div><script>var orders=[],S='+JSON.stringify(CFG.statuses)+',P='+JSON.stringify(CFG.payments)+',C='+JSON.stringify(CFG.carriers)+ ';function load(){google.script.run.withSuccessHandler(function(x){orders=x||[];render()}).dashboardOrders()}function opts(a,v){return a.map(function(x){return "<option "+(x===v?"selected":"")+">"+x+"</option>"}).join("")}function render(){var q=(document.getElementById("q").value||"").toLowerCase(),a=orders.filter(function(o){return (o.orderId+" "+o.customerName+" "+o.phone+" "+o.trackingNumber).toLowerCase().indexOf(q)>=0});document.getElementById("list").innerHTML=a.length?a.map(function(o){return "<div class=card><b>"+o.orderId+"</b> <span class=tag>"+o.status+"</span><p><b>"+o.customerName+"</b><br>"+o.phone+"<br>"+o.address+"</p><div class=row><label>Order status<select onchange=save('updateOrderStatus','"+o.orderId+"',this.value)>"+opts(S,o.status)+"</select></label><label>Payment status<select onchange=save('updatePaymentStatus','"+o.orderId+"',this.value)>"+opts(P,o.paymentStatus)+"</select></label><label>Carrier<select onchange=save('updateCarrier','"+o.orderId+"',this.value)>"+opts(C,o.carrier)+"</select></label><label>Tracking no.<input value="+JSON.stringify(o.trackingNumber||"")+" onblur=save('updateTracking','"+o.orderId+"',this.value)></label></div><p class=muted>Payment mobile: "+(o.paymentMobile||"-")+" · Transaction ID: "+(o.transactionId||"-")+" · Total: ৳"+o.total+"</p><div class=actions><button class=btn onclick=printLabel('"+o.orderId+"')>Print label</button><button class="btn alt" onclick=printInvoice('"+o.orderId+"')>Invoice</button></div></div>"}).join(""):"<div class=empty>No orders found</div>"}function save(fn,id,v){google.script.run.withSuccessHandler(function(x){orders=orders.map(function(o){return o.orderId===id?x:o});render()}).withFailureHandler(function(e){alert(e.message)})[fn](id,v)}function printLabel(id){var o=orders.find(function(x){return x.orderId===id});if(!o)return;var w=window.open('','shipping_label_'+String(o.orderId).replace(/[^a-zA-Z0-9_-]/g,''),'width=420,height=720');if(!w){alert('Print window was blocked. Please allow pop-ups for this Google Sheet and try again.');return}var esc=function(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;')};var html='<!doctype html><html><head><meta charset="utf-8"><title>Shipping Label - '+esc(o.orderId)+'</title><style>@page{size:58mm auto;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#fff;color:#111}body{font-family:Arial,sans-serif;font-size:11px;line-height:1.35;width:58mm}.label{width:58mm;padding:4mm 3mm}.center{text-align:center}.brand{font-size:15px;font-weight:700}.title{font-size:13px;font-weight:700;margin:3mm 0}.line{border-top:1px dashed #111;margin:3mm 0}.field{margin:1.5mm 0;overflow-wrap:anywhere}.value{font-weight:600}.footer{font-size:9px;margin-top:4mm;text-align:center}@media print{html,body{width:58mm!important;min-height:0!important}.label{break-inside:avoid}}@media screen{body{margin:12px;box-shadow:0 0 0 1px #ddd}.label{min-height:80mm}}</style></head><body><main class="label"><div class="center brand">ELECTRONICS DOKAN</div><div class="center title">SHIPPING LABEL</div><div class="line"></div><div class="field"><b>Order:</b> <span class="value">'+esc(o.orderId)+'</span></div><div class="field"><b>Customer:</b> <span class="value">'+esc(o.customerName)+'</span></div><div class="field"><b>Phone:</b> '+esc(o.phone)+'</div><div class="field"><b>Address:</b> '+esc(o.address)+'</div><div class="field"><b>Area:</b> '+esc(o.area)+'</div><div class="field"><b>District:</b> '+esc(o.district)+'</div><div class="line"></div><div class="field"><b>Items:</b> '+esc(o.products)+'</div><div class="field"><b>Qty:</b> '+esc(o.quantity)+'</div><div class="field"><b>Carrier:</b> '+esc(o.carrier||'Not assigned')+'</div><div class="field"><b>Tracking:</b> '+esc(o.trackingNumber||'Not assigned')+'</div><div class="field"><b>Collect:</b> <span class="value">৳'+Number(o.total||0).toLocaleString('en-BD')+'</span></div><div class="line"></div><div class="footer">Please keep this label attached to the parcel.</div></main></body></html>';w.document.open();w.document.write(html);w.document.close();var printed=false;var finish=function(){if(printed)return;printed=true;w.focus();setTimeout(function(){w.print()},250)};w.addEventListener('load',finish,{once:true});w.addEventListener('afterprint',function(){google.script.run.withFailureHandler(function(){}).markLabelPrinted(id);setTimeout(function(){w.close()},300)},{once:true});setTimeout(finish,1000)}function printInvoice(id){printLabel(id)}load();</script>`}
function onOpen(){SpreadsheetApp.getUi().createMenu('Order Dashboard').addItem('Open dashboard','showDashboard').addItem('Setup dropdowns','setupOrdersSheet').addToUi()}
function showDashboard(){SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutput(dash_()).setTitle('Order Desk'))}
