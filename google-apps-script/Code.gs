tTimeout(function(){w.print();},300);};w.addEventListener('load',go,{once:true});w.addEventListener('afterprint',function(){if(!invoice)google.script.run.withFailureHandler(function(){}).markLabelPrinted(id);setTimeout(function(){w.close();},300);},{once:true});setTimeout(go,1000);}
  load();
