;border-radius:10px;padding:10px;margin:12px 0}.meta div{min-width:0}.meta small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.04em}.meta strong{display:block;margin-top:2px;overflow-wrap:anywhere}.controls{display:grid;grid-template-columns:1fr 1fr;gap:8px}.controls label{font-size:11px;color:var(--muted);font-weight:700}.controls select,.controls input{width:100%;margin-top:4px;border:1px solid #cbd5e1;border-radius:8px;padding:8px;background:#fff}.actions{display:flex;gap:7px;margin-top:12px}.btn{border:0;border-radius:8px;padding:9px 11px;background:var(--teal);color:#fff;font-weight:700;cursor:pointer}.btn.alt{background:#e8eef5;color:var(--navy)}.btn.danger{background:#fee2e2;color:#991b1b}.empty{grid-column:1/-1;text-align:center;background:#fff;border:1px dashed #cbd5e1;border-radius:14px;padding:40px;color:var(--muted)}.notice{display:none;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:10px;padding:10px;margin-bottom:12px}
  @media(max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}#list{grid-template-columns:1fr}.toolbar{flex-wrap:wrap}.search{flex-basis:100%}.wrap{padding:14px}.top{padding:18px}}
  </style></head><body><header class="top"><h1>Electronics Dokan Order Desk</h1><p>Admin dashboard · Orders, payments, delivery & 58mm printing</p></header><main class="wrap"><div class="stats"><div class="stat"><small>Total orders</small><b id="total">—</b></div><div class="stat"><small>Pending</small><b id="pending">—</b></div><div class="stat"><small>Paid / confirmed</small><b id="paid">—</b></div><div class="stat"><small>Shipped</small><b id="shipped">—</b></div></div><div id="notice" class="notice"></div><div class="toolbar"><input id="q" class="search" placeholder="Search order ID, customer, phone or tracking…" oninput="render()"><select id="statusFilter" class="filter" onchange="render()"><option value="">All statuses</option></select><select id="paymentFilter" class="filter" onchange="render()"><option value="">All payments</option></select><button class="refresh" onclick="load()">↻ Refresh</button></div><div class="section"><h2>Recent orders</h2><span id="count" class="count"></span></div><div id="list"></div></main><script>
  var orders=[], S=${statuses}, P=${payments}, C=${carriers};
  function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
  function opts(a,v){return a.map(function(x){return '<option value="'+esc(x)+'" '+(x===v?'selected':'')+'>'+esc(x)+'</option>';}).join('');}
  function showError(e){var n=document.getElementById('notice');n.style.display='block';n.textContent='Could not load orders: '+(e&&e.message||e||'Unknown error');}
  function load(){document.getElementById('list').innerHTML='<div class="empty">Loading orders…</div>';google.script.run.withSuccessHandler(function(x){orders=x||[];document.getElementById('notice').style.display='none';setupFilters();render();}).withFailureHandler(showError).dashboardOrders();}
  function setupFilters(){var sf=document.getElementById('statusFilter'),pf=document.getElementById('paymentFilter'),sv=sf.value,pv=pf.value;sf.innerHTML='<option value="">All statuses</option>'+opts(S,'');pf.innerHTML='<option value="">All payments</option>'+opts(P,'');sf.value=sv;pf.value=pv;}
  function render(){var q=(document.getElementById('q').value||'').toLowerCase(),sf=document.getElementById('statusFilter').value,pf=document.getElementById('paymentFilter').value;var a=orders.filter(function(o){var text=[o.orderId,o.customerName,o.phone,o.whatsapp,o.email,o.trackingNumber,o.products].join(' ').toLowerCase();return (!q||text.indexOf(q)>=0)&&(!sf||o.status===sf)&&(!pf||o.paymentStatus===pf);});document.getElementById('count').textContent=a.length+' shown';document.getElementById('total').textContent=orders.length;document.getElementById('pending').textContent=orders.filter(function(o){return o.status==='Pending';}).length;document.getElementById('paid').textContent=orders.filter(function(o){return o.paymentStatus==='Paid / Confirmed';}).length;document.getElementById('shipped').textContent=orders.filter(function(o){return o.status==='Shipped'||o.status==='In Transit';}).length;document.getElementById('list').innerHTML=a.length?a.map(card).join(''):'<div class="empty">No matching orders found.<br><small>Try clearing search or filters.</small></div>';}
  function card(o){return '<article class="card"><div class="cardhead"><div><div class="oid">'+esc(o.orderId)+'</div><div class="date">'+esc(o.dateTime)+'</div></div><span class="pill">'+esc(o.status||'Pending')+'</span></div><div class="customer"><b>'+esc(o.customerName||'Unnamed customer')+'</b><br>'+esc(o.phone||'No phone')+'<div class="address">'+esc(o.address||'No address')+(o.area?', '+esc(o.area):'')+(o.district?', '+esc(o.district):'')+'</div></div><div class="meta"><div><small>Total</small><strong>৳'+Number(o.total||0).toLocaleString('en-BD')+'</strong></div><div><small>Payment</small><strong>'+esc(o.paymentStatus||o.paymentMethod||'Pending')+'</strong></div><div><small>Transaction</small><strong>'+esc(o.transactionId||'—')+'</strong></div><div><small>Tracking</small><strong>'+esc(o.trackingNumber||'—')+'</strong></div></div><div class="controls"><label>Order status<select onchange="save(\'updateOrderStatus\',\''+esc(o.orderId)+'\',this.value)">'+opts(S,o.status)+'</select></label><label>Payment status<select onchange="save(\'updatePaymentStatus\',\''+esc(o.orderId)+'\',this.value)">'+opts(P,o.paymentStatus)+'</select></label><label>Carrier<select onchange="save(\'updateCarrier\',\''+esc(o.orderId)+'\',this.value)">'+opts(C,o.carrier)+'</select></label><label>Tracking no.<input value="'+esc(o.trackingNumber||'')+'" onblur="save(\'updateTracking\',\''+esc(o.orderId)+'\',this.value)"></label></div><div class="actions"><button class="btn" onclick="printDoc(\''+esc(o.orderId)+'\',false)">Print label</button><button class="btn alt" onclick="printDoc(\''+esc(o.orderId)+'\',true)">Invoice</button></div></article>';}
